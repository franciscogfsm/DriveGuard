# DriveGuard API Configuration
# Copy this file to .env and fill in your actual API keys

# Portuguese Traffic API
# Get your API key from: [Traffic API Provider URL]
VITE_TRAFFIC_API_KEY=your_traffic_api_key_here
VITE_TRAFFIC_API_URL=https://api.traffic-provider.pt/v1

# Weather API
# Get your API key from: [Weather API Provider URL]
VITE_WEATHER_API_KEY=your_weather_api_key_here
VITE_WEATHER_API_URL=https://api.weather-provider.pt/v1

# Map Service (Optional - if using external map provider)
VITE_MAP_API_KEY=your_map_api_key_here
